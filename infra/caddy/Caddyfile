# infra/caddy/Caddyfile
{$DOMAIN} {
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }

    @webhook path /webhook/telegram
    handle @webhook {
        reverse_proxy bot:8001
    }

    handle {
        reverse_proxy miniapp:80
    }

    log {
        output stdout
        format console
        level INFO
    }
}
