# .env.production.example
# Copy to .env.production and fill in real values, then `./scripts/deploy.sh`.
# DO NOT commit .env.production.

# --- Public hostname ---
# Required. Used by Caddy for auto-TLS. Example: slotbook.example.com
# For HTTP-only local prod testing use DOMAIN=:80. Auto-HTTPS is off in that
# case, but APP_ENV=prod still requires BOT_MODE=webhook plus HTTPS values in
# BOT_WEBHOOK_URL and MINI_APP_URL: the preflight in app/core/config.py rejects
# polling and non-HTTPS URLs. Use placeholder HTTPS hosts, not blanks. Telegram
# will not deliver to them, which is fine when you only smoke-test the stack.
DOMAIN=

# --- App env ---
APP_ENV=prod
APP_DEBUG=false

# --- Database ---
# Use a strong random password. Generator:
#   openssl rand -base64 24
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=

# DATABASE_URL is constructed automatically in docker-compose.prod.yml from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB. Do not set it here.
#
# env_file values are passed verbatim by Docker Compose — ${VAR} references
# are NOT interpolated. Putting DATABASE_URL here would deliver the literal
# string "${POSTGRES_PASSWORD}" to the container.

# --- Auth ---
# Generate a long random secret. The token is HS256-signed with this.
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Telegram bot ---
# Token from @BotFather.
BOT_TOKEN=
# Bot username without @ (e.g. slotbook_bot). Used to generate invite links
# like t.me/<BOT_USERNAME>?start=invite_<token>.
BOT_USERNAME=
# Comma-separated Telegram numeric IDs. These users are promoted to admin on first auth.
BOT_ADMIN_TELEGRAM_IDS=

# Webhook mode is recommended for production (no outbound polling).
BOT_MODE=webhook
# Must match the public URL Caddy serves. Used for setWebhook on bot startup.
BOT_WEBHOOK_URL=https://${DOMAIN}/webhook/telegram
# Long random string. Telegram sends it back in X-Telegram-Bot-Api-Secret-Token header.
#   openssl rand -hex 24
BOT_WEBHOOK_SECRET_TOKEN=
BOT_WEBHOOK_PORT=8001
BOT_ADMIN_NOTIFY_LIMIT=10

# Public URL of the Mini App (where Caddy serves it). Used in inline-keyboard buttons.
MINI_APP_URL=https://${DOMAIN}

# --- Business defaults (used by the singleton-bootstrap seed) ---
BUSINESS_NAME=Demo Studio
BUSINESS_TIMEZONE=Europe/Moscow
BUSINESS_BOOKING_BUFFER_MINUTES=0
BUSINESS_MIN_CANCELLATION_HOURS=2
BUSINESS_SLOT_STEP_MINUTES=15

# --- Worker ---
WORKER_TICK_SECONDS=60
