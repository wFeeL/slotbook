APP_ENV=local
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_test

BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
# Bot username without @ (e.g. slotbook_bot). Used to build invite links.
BOT_USERNAME=
BOT_ADMIN_TELEGRAM_IDS=

JWT_SECRET=change_me_in_real_env
JWT_EXPIRE_MINUTES=1440

BUSINESS_NAME=Demo Studio
BUSINESS_TIMEZONE=Europe/Moscow
BUSINESS_BOOKING_BUFFER_MINUTES=0
BUSINESS_MIN_CANCELLATION_HOURS=2
BUSINESS_SLOT_STEP_MINUTES=15

BOT_MODE=polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET_TOKEN=
BOT_WEBHOOK_PORT=8001
MINI_APP_URL=https://miniapp.example.com
BOT_ADMIN_NOTIFY_LIMIT=10
