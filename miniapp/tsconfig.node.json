{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "composite": true,
    "noEmit": false
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tailwind.config.ts", "eslint.config.js", "postcss.config.js"]
}
